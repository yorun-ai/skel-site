{
  "name": "@yorun-ai/skel-site",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm",
  "scripts": {
    "start": "docusaurus serve --build --no-open",
    "dev": "docusaurus start --locale en",
    "dev:zh": "docusaurus start --locale zh-CN",
    "dev:en": "docusaurus start --locale en",
    "build": "docusaurus build",
    "typecheck": "tsc --noEmit",
    "audit:security": "pnpm audit --prod --audit-level high --ignore GHSA-5c6j-r48x-rmvq",
    "serve": "docusaurus serve --no-open",
    "clear": "docusaurus clear"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@mdx-js/react": "^3.1.1",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "prism-react-renderer": "^2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.2",
    "typescript": "~7.0.2",
    "wrangler": "4.114.0"
  },
  "engines": {
    "node": ">=20.0",
    "pnpm": ">=11.15.1 <12"
  }
}
